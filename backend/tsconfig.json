{
  // Editor / type-checking config. This is what VS Code's TS server uses,
  // so it must cover EVERY .ts file you open — including prisma.config.ts
  // at the repo root. Keeping "types": ["node"] here is what makes
  // `process`, `__dirname`, etc. available in those files; merely having
  // @types/node installed is not enough if the file isn't included.
  // Actual emit is done by tsconfig.build.json (see the `build` script).
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "noEmit": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts", "./prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
