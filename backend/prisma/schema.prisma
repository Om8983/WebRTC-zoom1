generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String               @id @unique @default(uuid())
  userName String
  email    String               @unique
  password String?
  googleId String?
  meetings MeetingParticipant[]
}

model Meeting {
  id                   String               @id @unique @default(uuid())
  meetingCode          String               @unique
  createdAt            DateTime             @default(now())
  endTime              DateTime?
  meetingStatus        MeetingStatus
  isMeetingCodeInvalid Boolean?             @default(false)
  participants         MeetingParticipant[]
}

model MeetingParticipant {
  participantId String
  joinedAt      DateTime?
  leaveAt       DateTime?
  meetingId     String
  joinStatus    ParticipantJoinStatus
  role          Role
  meeting       Meeting               @relation(fields: [meetingId], references: [id])
  user          User                  @relation(fields: [participantId], references: [id])

  @@unique([meetingId, participantId])
}

enum Role {
  HOST
  PARTICIPANT
  INVITED
}

enum ParticipantJoinStatus {
  PENDING
  JOINED
  DECLINED
}

enum MeetingStatus {
  ACTIVE
  END
}
